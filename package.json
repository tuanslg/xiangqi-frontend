{
  "name": "xiangqi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-headers.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck -w @xiangqi/shared -w @xiangqi/server",
    "dev:server": "npm run dev -w @xiangqi/server",
    "engine:fetch": "npm run engine:fetch -w @xiangqi/server"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15",
    "@xiangqi/shared": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  },
  "workspaces": [
    "packages/*"
  ]
}
